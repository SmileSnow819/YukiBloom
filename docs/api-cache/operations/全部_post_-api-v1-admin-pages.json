{
  "document": "全部",
  "method": "POST",
  "operation": {
    "consumes": ["application/json"],
    "description": "需要登录和 CSRF 令牌。",
    "parameters": [
      {
        "description": "登录接口返回的 csrfToken",
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "type": "string"
      },
      {
        "description": "页面内容",
        "in": "body",
        "name": "page",
        "required": true,
        "schema": {
          "$ref": "#/definitions/sitecontent.Page"
        }
      }
    ],
    "produces": ["application/json"],
    "responses": {
      "201": {
        "description": "新建页面",
        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/apiresponse.Envelope"
            },
            {
              "properties": {
                "data": {
                  "$ref": "#/definitions/sitecontent.Page"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "400": {
        "description": "code=10001，页面内容无效",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "401": {
        "description": "code=10002，尚未登录",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "403": {
        "description": "code=10003，CSRF 校验失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "409": {
        "description": "code=10005，语言和链接标识已被占用",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "500": {
        "description": "code=50000，保存失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      }
    },
    "summary": "创建页面草稿",
    "tags": ["管理页面"]
  },
  "path": "/api/v1/admin/pages"
}
