{
  "document": "全部",
  "method": "GET",
  "operation": {
    "parameters": [
      {
        "description": "文章链接标识",
        "in": "path",
        "name": "slug",
        "required": true,
        "type": "string"
      },
      {
        "description": "语言代码，例如 zh-CN",
        "in": "query",
        "name": "locale",
        "required": true,
        "type": "string"
      }
    ],
    "produces": ["application/json"],
    "responses": {
      "200": {
        "description": "文章详情",
        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/apiresponse.Envelope"
            },
            {
              "properties": {
                "data": {
                  "$ref": "#/definitions/posts.Post"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "400": {
        "description": "code=10001，语言代码无效",
