{
  "document": "全部",
  "method": "POST",
  "operation": {
    "consumes": ["application/json"],
    "description": "验证管理员账号并设置 HttpOnly 会话 Cookie。成功响应中的 csrfToken 用于后续写请求。",
    "parameters": [
      {
        "description": "登录凭据",
        "in": "body",
        "name": "request",
        "required": true,
        "schema": {
          "$ref": "#/definitions/auth.LoginInput"
        }
      }
    ],
    "produces": ["application/json"],
    "responses": {
      "200": {
        "description": "登录成功，返回 csrfToken，并通过 Set-Cookie 设置会话",
        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/apiresponse.Envelope"
            },
            {
              "properties": {
                "data": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "400": {
        "description": "code=10001，用户名或密码为空或格式错误",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "401": {
        "description": "code=10002，用户名或密码错误",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "429": {
        "description": "code=10007，登录尝试过多",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "500": {
        "description": "code=50000，登录服务暂不可用",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      }
    },
    "summary": "管理员登录",
    "tags": ["管理员会话"]
  },
  "path": "/api/v1/admin/login"
}
