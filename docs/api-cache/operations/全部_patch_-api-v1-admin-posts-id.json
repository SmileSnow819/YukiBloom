{
  "document": "全部",
  "method": "PATCH",
  "operation": {
    "consumes": ["application/json"],
    "description": "需要登录和 CSRF 令牌。请求中的 version 必须与读取文章时一致，否则返回冲突。",
    "parameters": [
      {
        "description": "文章 UUID",
        "in": "path",
        "name": "id",
        "required": true,
        "type": "string"
      },
      {
        "description": "登录接口返回的 csrfToken",
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "type": "string"
      },
      {
        "description": "文章新内容及当前 version",
        "in": "body",
        "name": "post",
        "required": true,
        "schema": {
          "$ref": "#/definitions/posts.PostInput"
        }
      }
    ],
    "produces": ["application/json"],
    "responses": {
      "200": {
        "description": "更新后的文章",
        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/apiresponse.Envelope"
            },
            {
              "properties": {
                "data": {
                  "$ref": "#/definitions/posts.Post"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "400": {
        "description": "code=10001，请求内容、文章 ID 或封面图片无效",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "401": {
        "description": "code=10002，尚未登录",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "403": {
        "description": "code=10003，CSRF 校验失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "404": {
        "description": "code=10004，文章不存在",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "409": {
        "description": "code=10005，文章已被其他操作修改或链接标识冲突",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "500": {
        "description": "code=50000，保存失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      }
    },
    "summary": "修改文章",
    "tags": ["管理文章"]
  },
  "path": "/api/v1/admin/posts/{id}"
}
