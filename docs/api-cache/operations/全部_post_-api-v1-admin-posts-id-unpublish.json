{
  "document": "全部",
  "method": "POST",
  "operation": {
    "description": "需要登录和 CSRF 令牌。撤回后文章不再出现在公开接口。",
    "parameters": [
      {
        "description": "文章 UUID",
        "in": "path",
        "name": "id",
        "required": true,
        "type": "string"
      },
      {
        "description": "登录接口返回的 csrfToken",
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "type": "string"
      }
    ],
    "produces": ["application/json"],
    "responses": {
      "200": {
        "description": "已撤回文章",
        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/apiresponse.Envelope"
            },
            {
              "properties": {
                "data": {
                  "$ref": "#/definitions/posts.Post"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "400": {
        "description": "code=10001，文章 ID 格式错误",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "401": {
        "description": "code=10002，尚未登录",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "403": {
        "description": "code=10003，CSRF 校验失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "404": {
        "description": "code=10004，文章不存在",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      },
      "500": {
        "description": "code=50000，撤回失败",
        "schema": {
          "$ref": "#/definitions/apiresponse.Envelope"
        }
      }
    },
    "summary": "撤回文章",
    "tags": ["管理文章"]
  },
  "path": "/api/v1/admin/posts/{id}/unpublish"
}
