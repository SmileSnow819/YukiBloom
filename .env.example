# ANALYZE=true
BLOG_PORT=4321

# Server-side origin for public content requests (without /api/v1).
BACKEND_API_URL=http://localhost:8080
# Address reachable from the Astro container's Docker network (start the backend
# Compose stack first; its api service joins the shared yukibloom-public network).
BACKEND_API_URL_DOCKER=http://api:8080

# Copy to .env to split the sibling backend's Swagger document into docs/api-cache.
API_CACHE_SOURCE_FILE=../YukiBloom-backend/api-docs/swagger.json

# REACT_GRAB=true
