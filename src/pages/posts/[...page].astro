---
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING, PAGINATION } from '@constants/layout';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import Divider from '@/components/ui/divider';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import { getLocalizedPublicPosts, getPostCategoryNames, getPublicSiteContent, toPublicPostCardData } from '@/lib/public-api';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url.pathname);
const pageSegment = Astro.params.page ?? '1';
if (!/^\d+$/.test(pageSegment)) Astro.response.status = 404;
const currentPage = Math.max(1, Number.parseInt(pageSegment, 10) || 1);
const [allPosts, siteContent] = await Promise.all([getLocalizedPublicPosts(locale), getPublicSiteContent()]);
const featuredCategoryNames = new Set(
  siteContent.featuredSeries.filter((series) => series.enabled).map((series) => series.categoryName),
);
const posts = allPosts.filter((post) => !getPostCategoryNames(post).some((name) => featuredCategoryNames.has(name)));
const { pageSize } = PAGINATION;
const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
if (currentPage > lastPage) Astro.response.status = 404;
const offset = (currentPage - 1) * pageSize;
const postCards = posts.slice(offset, offset + pageSize).map(toPublicPostCardData);
const baseUrl = localizedPath('/posts', locale);
const pageNavigation = {
  currentPage,
  lastPage,
  url: {
    prev: currentPage > 1 ? (currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`) : undefined,
    next: currentPage < lastPage ? `${baseUrl}/${currentPage + 1}` : undefined,
  },
};
---

<Layout title={seoConfig.title}>
  <TwoColumnLayout>
    <Cover slot="cover" />
    <HomeSider slot="sider" />
    <div
      class={`shadow-box bg-gradient-start tablet:shadow-none flex flex-col gap-4 overflow-hidden ${CONTENT_PADDING.standard}`}
    >
      <Divider>{t(locale, 'post.postList')}</Divider>
      <PostList posts={postCards} page={pageNavigation} baseUrl={baseUrl} />
    </div>
  </TwoColumnLayout>
</Layout>
