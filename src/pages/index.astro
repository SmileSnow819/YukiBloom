---
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING, PAGINATION } from '@constants/layout';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import CategoryCards from '@/components/post/CategoryCards.astro';
import Divider from '@/components/ui/divider';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import {
  getExtraBoolean,
  getLocalizedPublicPosts,
  getPostCategoryNames,
  getPublicSiteContent,
  toPublicPostCardData,
} from '@/lib/public-api';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url.pathname);
const [allPosts, siteContent] = await Promise.all([getLocalizedPublicPosts(locale), getPublicSiteContent()]);
const enabledSeries = siteContent.featuredSeries.filter((series) => series.enabled);
const featuredCategoryNames = new Set(enabledSeries.map((series) => series.categoryName));
const getMatchingCategory = (post: (typeof allPosts)[number], name: string) => getPostCategoryNames(post).includes(name);

const highlightedPosts = enabledSeries
  .filter((series) => series.highlightOnHome !== false)
  .map((series) => allPosts.find((post) => getMatchingCategory(post, series.categoryName)))
  .filter((post): post is NonNullable<typeof post> => post !== undefined);
const featuredPosts = allPosts.filter((post) => getPostCategoryNames(post).some((name) => featuredCategoryNames.has(name)));
const stickyPosts = allPosts.filter((post) => !featuredPosts.includes(post) && getExtraBoolean(post, 'sticky'));
const regularPosts = allPosts.filter((post) => !featuredPosts.includes(post) && !getExtraBoolean(post, 'sticky'));

const stickyCards = [...highlightedPosts, ...stickyPosts].map(toPublicPostCardData);
const { pageSize } = PAGINATION;
const regularPostsSlice = regularPosts.slice(0, pageSize);
const posts = regularPostsSlice.map(toPublicPostCardData);
const lastPage = Math.max(1, Math.ceil(regularPosts.length / pageSize));
const postsBaseUrl = localizedPath('/posts', locale);
const page = {
  currentPage: 1,
  lastPage,
  url: {
    prev: undefined,
    next: regularPosts.length > pageSize ? `${postsBaseUrl}/2` : undefined,
  },
};
---

<Layout title={seoConfig.title}>
  <TwoColumnLayout>
    <Cover slot="cover" />
    <HomeSider slot="sider" />
    <div
      class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-4 overflow-hidden  ${CONTENT_PADDING.standard}`}
    >
      {stickyCards.length > 0 && (
        <>
          <Divider>{t(locale, 'post.stickyPosts')}</Divider>
          <PostList posts={stickyCards} showPaginator={false} />
        </>
      )}
      <Divider>{t(locale, 'post.postList')}</Divider>
      <PostList posts={posts} page={page} showPaginator={true} baseUrl={postsBaseUrl} isHomePage={true} />
      {siteContent.categories.some((category) => category.showOnHome) && (
        <>
          <Divider className="mt-6">{t(locale, 'post.featuredCategories')}</Divider>
          <CategoryCards siteContent={siteContent} />
        </>
      )}
    </div>
  </TwoColumnLayout>
</Layout>
