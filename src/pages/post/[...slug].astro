---
import CustomContent from '@components/common/CustomContent.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import SummaryPanel, { type SummarySource } from '@components/post/SummaryPanel';
import Cover from '@components/ui/cover/Cover.astro';
import { defaultContentConfig } from '@constants/content-config';
import { HomeSiderType } from '@constants/enum';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { buildCategoryPath, getCategoryArr } from '@lib/content/category-path';
import { translateCategoryName } from '@lib/content/category-translate';
import { formatForSeo } from '@lib/date';
import { renderMarkdown } from '@lib/markdown/render-markdown';
import { encodeSlug } from '@lib/route';
import { getOgImageUrl } from '@lib/seo/og-image';
import { Icon } from 'astro-icon/components';
import { Comment } from '@/components/comment';
import EditButton from '@/components/EditButton';
import { defaultLocale, getLocaleFromUrl, getLocaleLabel, localizedPath, t } from '@/i18n';
import {
  getPublicPost,
  getPublicSiteContent,
  PublicApiNotFoundError,
  type PublicPost,
  toPublicPostPageModel,
} from '@/lib/public-api';
import { extractTextFromMarkdown } from '@/lib/sanitize';

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url.pathname);
const postSlug = Astro.params.slug ?? '';
let apiPost: PublicPost | undefined;
try {
  apiPost = await getPublicPost(postSlug, locale);
} catch (error) {
  if (!(error instanceof PublicApiNotFoundError) || locale === defaultLocale) throw error;
  try {
    apiPost = await getPublicPost(postSlug, defaultLocale);
  } catch (fallbackError) {
    if (!(fallbackError instanceof PublicApiNotFoundError)) throw fallbackError;
  }
}

const post = apiPost ? toPublicPostPageModel(apiPost) : undefined;
if (!post) Astro.response.status = 404;
const isFallback = post !== undefined && post.locale !== locale;
const canonicalUrl =
  isFallback && post ? new URL(localizedPath(`/post/${encodeSlug(post.slug)}`, defaultLocale), Astro.site).href : undefined;
const title = post?.data.title ?? t(locale, 'post.noPostsFound');
const categories = post?.data.categories ?? [];
const tags = post?.data.tags ?? [];
const finalDescription = post?.protectedContent
  ? t(locale, 'encrypted.post.description')
  : post?.data.description || (post ? extractTextFromMarkdown(post.body, 150) : '');
const profile = (await getPublicSiteContent()).profile;
const ogImage = getOgImageUrl(post?.data.cover, Astro.site, profile);
const renderedHtml = post
  ? await renderMarkdown(post.body, {
      ...post.data,
      ...(post.protectedContent && typeof apiPost?.extra?.password === 'string' ? { password: apiPost.extra.password } : {}),
    })
  : undefined;
const hasMath = defaultContentConfig.enableMath !== false && post?.data.math !== false;

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: finalDescription,
      keywords: categories.length ? tags.concat(categories[0] ?? []) : tags,
      author: { '@type': 'Person', name: siteConfig.author ?? siteConfig.name, url: Astro.site },
      datePublished: formatForSeo(post.data.date),
      ...(post.data.updated && { dateModified: formatForSeo(post.data.updated) }),
      ...(ogImage && { image: ogImage }),
      mainEntityOfPage: Astro.url.href,
    }
  : undefined;

const categoryArr = getCategoryArr(categories[0]);
const categoryStr = categoryArr.length
  ? ` | ${categoryArr.map((category) => translateCategoryName(category, locale)).join(' / ')}`
  : '';
const breadcrumbCategories = categoryArr.map((category, index) => ({
  name: translateCategoryName(category, locale),
  link: localizedPath(buildCategoryPath(categoryArr.slice(0, index + 1)), locale),
}));
const homeName = t(locale, 'breadcrumb.home');
const breadcrumbJsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: homeName, item: new URL(localizedPath('/', locale), Astro.site).href },
        ...breadcrumbCategories.map((category, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: category.name,
          item: new URL(category.link, Astro.site).href,
        })),
        { '@type': 'ListItem', position: breadcrumbCategories.length + 2, name: title },
      ],
    }
  : undefined;
let summaryText: string | null = post?.data.description || (post ? extractTextFromMarkdown(post.body, 200) : null);
let summarySource: SummarySource | null = summaryText ? (post?.data.description ? 'description' : 'auto') : null;
if (post?.protectedContent) {
  summaryText = null;
  summarySource = null;
}
---

<Layout
  title={`${title}${categoryStr} | ${siteConfig.title}`}
  description={finalDescription}
  siderType={HomeSiderType.POST}
  post={post}
  canonical={canonicalUrl}
>
  {jsonLd && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {breadcrumbJsonLd && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
  {post && hasMath && <link slot="head" rel="stylesheet" href="/katex/katex.min.css" />}
  {
    post ? (
      <TwoColumnLayout post={post}>
        <Cover slot="cover" data={post} />
        <HomeSider slot="sider" type={HomeSiderType.POST} post={post} />
        <div class={`shadow-box bg-gradient-start flex flex-col gap-2 ${CONTENT_PADDING.standard}`}>
          <nav class="text-muted-foreground flex items-center justify-between gap-2 text-sm">
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1">
                <Icon name="fa6-solid:house-chimney" class="h-4 w-4" />
                <a href={localizedPath('/', locale)} aria-label={homeName}>
                  <span class="hover:text-blue transition-colors duration-300">{homeName}</span>
                </a>
              </div>
              {breadcrumbCategories.map((category, index) => (
                <>
                  <Icon name="ri:arrow-right-s-line" class="text-muted-foreground/60 h-4 w-4" />
                  <a
                    href={category.link}
                    class={`hover:text-blue transition-colors duration-300 ${index === breadcrumbCategories.length - 1 ? 'text-primary bg-primary/10 hover:text-primary hover:bg-primary/20 rounded-full px-2.5 py-1' : ''}`}
                    aria-label={t(locale, 'breadcrumb.goToCategory', { name: category.name })}
                  >
                    {category.name}
                  </a>
                </>
              ))}
            </div>
            {import.meta.env.DEV && <EditButton client:only="react" postId={post.id} />}
          </nav>
          {isFallback && (
            <div class="flex items-center gap-2 rounded-lg border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
              <Icon name="ri:translate-2" class="h-4 w-4 shrink-0" />
              <span>{t(locale, 'post.fallbackNotice', { lang: getLocaleLabel(locale) })}</span>
            </div>
          )}
          {summaryText && summarySource && <SummaryPanel client:visible summary={summaryText} source={summarySource} className="mt-2" />}
          <article class="prose md:prose-sm dark:prose-invert" data-pagefind-body>
            <CustomContent html={renderedHtml} />
          </article>
          <Comment />
        </div>
      </TwoColumnLayout>
    ) : (
      <main class="mx-auto w-full max-w-3xl px-6 py-16 text-center">{t(locale, 'post.noPostsFound')}</main>
    )
  }
</Layout>
