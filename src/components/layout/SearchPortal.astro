---
import PublicSearch from './PublicSearch';
---

<div id="search-component-portal">
  <PublicSearch client:load />
</div>

<script>
  function moveSearchToDialog() {
    const container = document.getElementById('search-dialog-container');
    const root = document.getElementById('search-for-dialog');
    if (container && root && !container.contains(root)) container.appendChild(root);
  }

  function moveSearchBack() {
    const portal = document.getElementById('search-component-portal');
    const root = document.getElementById('search-for-dialog');
    if (portal && root && !portal.contains(root)) portal.appendChild(root);
  }

  const handleOpen = () => requestAnimationFrame(moveSearchToDialog);
  const handleClose = () => moveSearchBack();
  let initialized = false;

  function initSearchPortal() {
    if (initialized) return;
    initialized = true;
    window.addEventListener('search-dialog-open', handleOpen);
    window.addEventListener('search-dialog-close', handleClose);
  }

  function cleanupSearchPortal() {
    if (!initialized) return;
    initialized = false;
    window.removeEventListener('search-dialog-open', handleOpen);
    window.removeEventListener('search-dialog-close', handleClose);
  }

  if (document.readyState !== 'loading') initSearchPortal();
  document.addEventListener('astro:page-load', initSearchPortal);
  document.addEventListener('astro:before-swap', cleanupSearchPortal);
</script>

<style>
  #search-component-portal {
    display: none;
    position: absolute;
    pointer-events: none;
    visibility: hidden;
  }
</style>
<style is:global>
  #search-dialog-container #search-for-dialog {
    display: block !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
</style>
