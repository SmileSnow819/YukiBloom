---
import { getPublicTimeline } from '@/lib/public-api';
import type { TimelineItem } from './Timeline';
import Timeline from './Timeline';

interface Props {
  useBackendData?: boolean;
}

const { useBackendData = true } = Astro.props;
const timeline = useBackendData ? await getPublicTimeline() : { items: [] };
const items: TimelineItem[] = timeline.items;
---

<Timeline items={items} client:load />
